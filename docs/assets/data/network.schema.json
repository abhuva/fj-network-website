{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft network directory",
  "description": "Country codes use ISO 3166-1 alpha-2. Stable record IDs do not imply formal membership. Dates use ISO 8601 calendar dates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "title", "updated", "status", "license", "license_note", "relationship_note", "organisations"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "format": "date" },
    "status": { "enum": ["draft", "reviewed"] },
    "license": { "type": ["string", "null"] },
    "license_note": { "type": "string", "minLength": 1 },
    "relationship_note": { "type": "string", "minLength": 1 },
    "organisations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "country_code", "url", "people", "review_status", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "people": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
          "review_status": { "enum": ["awaiting-organisation-review", "organisation-confirmed"] },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
        }
      }
    }
  }
}
